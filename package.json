  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@supabase/supabase-js": "^2.112.1",
    "@types/three": "^0.185.4",
    "@use-gesture/react": "^10.3.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.1",
    "lucide-react": "^0.427.0",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.2",
    "three": "^0.185.1",
    "typescript": "^7.0.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
