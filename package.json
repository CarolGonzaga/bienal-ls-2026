    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "nanoid": "^3.3.18",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "vite": "^8.2.1"
