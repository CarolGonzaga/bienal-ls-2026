  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender-seo.mjs && node scripts/audit-offline-package.mjs",
    "lint": "eslint .",
    "test:map": "node --experimental-strip-types --test src/tests/map/*.test.ts",
